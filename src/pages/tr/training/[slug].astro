---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { trainings } from '../../../data/trainings';
export function getStaticPaths() { return trainings.map((training) => ({ params: { slug: training.slug }, props: { training } })); }
const { training } = Astro.props;
---
<SiteLayout lang="tr" title={`${training.tr.title} | Ayti.Tech`} description={training.tr.summary}>
	<header class="hero"><div class="container"><a href="/tr/training">← Eğitim kataloğu</a><p class="eyebrow">{training.code} · {training.level}</p><h1>{training.tr.title}</h1><p class="lead">{training.tr.summary}</p></div></header>
	<section class="facts"><div class="container facts-grid"><div><span>Süre</span><b>{training.duration} gün</b></div><div><span>Katılımcı profili</span><b>{training.tr.audience}</b></div><div><span>Ön gereksinimler</span><b>{training.tr.prerequisites}</b></div></div></section>
	<section class="section content"><div class="container content-grid"><div><p class="eyebrow">Müfredat</p><h2>Eğitim içeriği</h2><ol>{training.tr.topics.map((topic, index) => <li><span>{String(index + 1).padStart(2,'0')}</span>{topic}</li>)}</ol></div><div><p class="eyebrow">Kazanımlar</p><h2>Ekibin kazanacakları</h2><ul>{training.tr.outcomes.map((outcome) => <li>{outcome}</li>)}</ul><a class="button" href="#contact">Bu programı tasarlayalım <span>↗</span></a></div></div></section>
</SiteLayout>
<style>
	.hero{padding:75px 0 90px;background:var(--yellow)}.hero .container>a{display:inline-block;margin-bottom:65px;font-weight:750;text-decoration:none}.hero h1{max-width:1050px;margin:0;font-size:clamp(3rem,7vw,6.7rem);line-height:.96;letter-spacing:0}.lead{max-width:760px;margin:40px 0 0;font-size:1.25rem;line-height:1.65}.facts{background:var(--ink);color:white}.facts-grid{display:grid;grid-template-columns:.45fr 1fr 1fr}.facts-grid div{min-height:160px;padding:28px;border-left:1px solid #3b4742}.facts-grid div:last-child{border-right:1px solid #3b4742}.facts span{display:block;margin-bottom:38px;color:var(--steel-blue);font-size:.72rem;font-weight:850;text-transform:uppercase}.facts b{line-height:1.5}.content{background:var(--paper-strong)}.content-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.content h2{margin:0 0 38px;font-size:clamp(2rem,4vw,3.8rem);line-height:1}.content ol,.content ul{margin:0 0 36px;padding:0;list-style:none;border-top:1px solid var(--line)}.content li{display:flex;gap:20px;padding:20px 0;border-bottom:1px solid var(--line);font-weight:700}.content li span{color:var(--orange);font-size:.72rem}.content ul li::before{content:'↗';color:var(--orange)}@media(max-width:760px){.hero{padding:55px 0 70px}.facts-grid,.content-grid{grid-template-columns:1fr}.facts-grid div{min-height:120px;border-right:1px solid #3b4742;border-bottom:1px solid #3b4742}.facts span{margin-bottom:20px}.content-grid{gap:60px}}
</style>
