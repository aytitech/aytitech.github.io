---
import SiteLayout from '../layouts/SiteLayout.astro';
import { trainings } from '../data/trainings';
---
<SiteLayout lang="en" title="Enterprise Training | Ayti.Tech" description="Custom, hands-on cloud, DevOps and platform engineering training.">
	<section class="hero"><div class="container"><p class="eyebrow">Training & Enablement</p><h1>Make knowledge<br />part of the team.</h1><p>Programmes designed around your context and reinforced through real practice.</p></div></section>
	<section class="section process"><div class="container grid"><div><p class="eyebrow">Programme design</p><h2 class="section-heading">From learning goals to working practice.</h2></div><ol><li><b>Needs assessment</b><span>Roles, current capability and business goals.</span></li><li><b>Custom curriculum</b><span>The right depth, examples and scenarios.</span></li><li><b>Hands-on learning</b><span>Live labs, workshops, hackathons and office hours.</span></li><li><b>Growth tracking</b><span>Assessment, feedback and next steps.</span></li></ol></div></section>
	<section class="section catalogue"><div class="container"><p class="eyebrow">Training catalogue</p><h2 class="section-heading">From foundations to production practice.</h2><div class="items">{trainings.map((item,i)=><a href={`/training/${item.slug}`}><span>{String(i+1).padStart(2,'0')} · {item.code}</span><h3>{item.en.title}</h3><p>{item.duration} days · {item.level}</p></a>)}</div></div></section>
</SiteLayout>
<style>
	.hero{padding:100px 0;background:var(--signal)}.hero h1{margin:0;font-size:clamp(4rem,10vw,8rem);line-height:.85;letter-spacing:0}.hero p:last-child{max-width:600px;margin:50px 0 0 auto;font-size:1.3rem;line-height:1.6}.process{background:var(--paper-strong)}.grid{display:grid;grid-template-columns:1.1fr .9fr;gap:90px}ol{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}li{display:grid;gap:8px;padding:22px 0;border-bottom:1px solid var(--line)}li span{color:var(--muted)}.catalogue{background:var(--ink);color:white}.items{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #46504c;border-left:1px solid #46504c}.items a{min-height:210px;padding:24px;border-right:1px solid #46504c;border-bottom:1px solid #46504c;color:white;text-decoration:none}.items a:hover{background:var(--steel-blue);color:var(--ink)}.items span{color:var(--signal);font-size:.7rem;font-weight:850}.items a:hover span{color:var(--ink)}.items h3{margin:38px 0 12px;font-size:1.25rem}.items p{margin:0;color:#aeb8b4;font-size:.82rem}.items a:hover p{color:var(--ink)}@media(max-width:760px){.hero{padding:70px 0}.grid{grid-template-columns:1fr;gap:40px}.items{grid-template-columns:1fr}.items a{min-height:150px}}
</style>