---
import SiteLayout from '../layouts/SiteLayout.astro';
import { services } from '../data/services';
const groups = [
	{ n: '01', key: 'Cloud', title: 'Cloud Foundations', intro: 'Make cloud infrastructure visible, governed and ready for change.', color: 'yellow' },
	{ n: '02', key: 'DevOps', title: 'DevOps & Delivery', intro: 'Make the path from idea to production fast, measurable and reliable.', color: 'teal' },
	{ n: '03', key: 'Platform', title: 'Platforms & Data', intro: 'Give teams secure, repeatable foundations for applications and data.', color: 'blue' },
	{ n: '04', key: 'Talent', title: 'Technical Talent', intro: 'Add specialist capability with a delivery model that fits your organization.', color: 'purple' },
];
---
<SiteLayout lang="en" title="Services | Ayti.Tech" description="Cloud, platform engineering, DevOps and enterprise technical training services.">
	<section class="hero"><div class="container"><p class="eyebrow">Services</p><h1>From strategy<br />to production.</h1><p>Technical services that leave behind working systems and capable teams.</p></div></section>
	{groups.map(g=><section class={`group ${g.color}`}><div class="container grid"><div><span>{g.n}</span><h2>{g.title}</h2><p>{g.intro}</p></div><ul>{services.filter(service => service.group === g.key).map(service=><li><a href={`/services/${service.slug}`}>{service.en.title}<span>↗</span></a></li>)}</ul></div></section>)}
	<section class="section method"><div class="container"><p class="eyebrow">Our model</p><h2 class="section-heading">Understand the system. Change it together.</h2><div class="steps"><p><b>01 · Discover</b><span>Establish the current architecture, flows and outcomes with evidence.</span></p><p><b>02 · Design</b><span>Make decisions, ownership and success measures explicit.</span></p><p><b>03 · Deliver</b><span>Implement with your team and make the knowledge durable.</span></p></div></div></section>
</SiteLayout>
<style>
	.hero{padding:110px 0 90px;background:var(--paper-strong)}h1{margin:0;font-size:clamp(4rem,9vw,8rem);line-height:.88;letter-spacing:0}.hero p:last-child{max-width:650px;margin:46px 0 0 auto;font-size:1.35rem;line-height:1.6}.group{padding:90px 0;border-top:1px solid #29312e}.yellow{background:var(--yellow)}.teal{background:var(--teal)}.blue{background:var(--blue)}.purple{background:var(--purple)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.grid h2{margin:20px 0;font-size:clamp(2.5rem,5vw,5rem);line-height:1}.grid p{font-size:1.1rem;line-height:1.65}.grid ul{margin:0;padding:0;list-style:none;border-top:1px solid #59615e}.grid li{border-bottom:1px solid #59615e;font-weight:750}.grid li a{display:flex;justify-content:space-between;gap:20px;padding:22px 0;text-decoration:none}.grid li a:hover{padding-left:12px}.method{background:var(--ink);color:white}.steps{border-top:1px solid #47504d}.steps p{display:grid;grid-template-columns:.7fr 1fr;gap:30px;margin:0;padding:24px 0;border-bottom:1px solid #47504d}.steps span{color:#bbc1be}@media(max-width:760px){.hero{padding:70px 0}.hero p:last-child{margin-left:0}.group{padding:64px 0}.grid{grid-template-columns:1fr;gap:35px}.steps p{grid-template-columns:1fr}}
</style>