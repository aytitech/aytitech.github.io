---
import SiteLayout from '../layouts/SiteLayout.astro';
import ClientLogos from '../components/ClientLogos.astro';
const services = [
	{ number:'01', title:'Cloud & Platform', text:'Reliable foundations through cloud architecture, platform engineering, Kubernetes and managed operations.', color:'blue' },
	{ number:'02', title:'DevOps & Delivery', text:'Faster, predictable delivery through CI/CD, GitOps, security and developer experience.', color:'orange' },
	{ number:'03', title:'Training & Enablement', text:'Hands-on enterprise training, workshops and coaching grounded in production systems.', color:'signal' },
];
---
<SiteLayout lang="en" title="Ayti.Tech | Cloud, DevOps and Technical Training" description="Ayti.Tech designs, delivers and transfers cloud, platform engineering and DevOps capabilities.">
	<section class="hero"><div class="container hero-grid"><div class="reveal"><p class="eyebrow">Cloud · DevOps · Platform Engineering</p><h1>We make<br />technology<br />work.</h1></div><div class="hero-side reveal"><p>Engineering, operations and training that move strategy into production.</p><div class="hero-actions"><a class="button" href="/services">Explore services <span>→</span></a><a href="#proof">How we work</a></div></div></div><div class="container capability-line"><span>AWS</span><span>AZURE</span><span>KUBERNETES</span><span>CLOUD NATIVE</span><span>OPEN SOURCE</span></div></section>
	<section class="section services"><div class="container"><p class="eyebrow">What we do</p><h2 class="section-heading">Consulting and training, built on the same engineering practice.</h2><div class="service-list">{services.map(service => <a class={`service-row service-row--${service.color}`} href="/services"><span>{service.number}</span><h3>{service.title}</h3><p>{service.text}</p><b>↗</b></a>)}</div></div></section>
	<section id="proof" class="section proof"><div class="container proof-grid"><div><p class="eyebrow">Experience from the field</p><h2 class="section-heading">Not another deck. A working system.</h2></div><div><p>Ayti.Tech started in 2019 with a mission to make technical knowledge accessible. Today, our Istanbul-based organization serves local and international teams, with a presence in Berlin.</p><dl><div><dt>50+</dt><dd>years combined field experience</dd></div><div><dt>3</dt><dd>connected areas of practice</dd></div><div><dt>2019</dt><dd>founded in Istanbul</dd></div></dl></div></div></section>
	<ClientLogos lang="en" />
	<section class="section testimonial"><div class="container"><p class="eyebrow">Client experience · SunExpress</p><blockquote>“The eight-month hands-on programme and Cloud Native Hackathon significantly improved our teams’ capabilities and became a critical step in our digital transformation.”</blockquote><p><b>Cenk Uysal</b> · IT Systems & Platform Manager</p></div></section>
</SiteLayout>
<style>
	.hero{min-height:calc(100svh - 72px);display:flex;flex-direction:column;justify-content:space-between;padding:88px 0 30px;background:var(--paper-strong)}.hero-grid{display:grid;grid-template-columns:1.65fr .75fr;gap:70px;align-items:end}h1{margin:0;font-size:clamp(4rem,9.7vw,8.4rem);line-height:.84;letter-spacing:0}.hero-side{padding-bottom:12px}.hero-side>p{margin:0 0 34px;font-size:clamp(1.15rem,2vw,1.5rem);line-height:1.45}.hero-actions{display:flex;align-items:center;gap:24px;font-weight:750}.capability-line{display:flex;justify-content:space-between;gap:20px;padding-top:28px;border-top:1px solid var(--line);color:var(--muted);font-size:.68rem;font-weight:850;letter-spacing:.08em}.services{background:var(--ink);color:white}.service-list{border-top:1px solid #414946}.service-row{display:grid;grid-template-columns:70px 1fr 1.2fr 40px;gap:28px;align-items:center;min-height:170px;border-bottom:1px solid #414946;text-decoration:none}.service-row h3{margin:0;font-size:clamp(1.6rem,3vw,3rem);letter-spacing:0}.service-row p{color:#bbc1be;line-height:1.6}.service-row b{text-align:right}.proof{background:var(--paper)}.proof-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:90px}.proof-grid>div:last-child>p{margin:40px 0 56px;font-size:1.2rem;line-height:1.7}dl{margin:0;border-top:1px solid var(--line)}dl div{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid var(--line)}dt{font-size:2rem;font-weight:850}dd{margin:0;color:var(--muted)}.testimonial{background:var(--blue)}blockquote{max-width:1060px;margin:0;font-size:clamp(2rem,4.5vw,4rem);font-weight:720;line-height:1.16;letter-spacing:0}.testimonial p:last-child{margin-top:42px}@media(max-width:800px){.hero{min-height:auto;padding-top:64px}.hero-grid,.proof-grid{grid-template-columns:1fr;gap:46px}h1{font-size:clamp(3.7rem,17vw,6rem)}.capability-line{margin-top:70px;flex-wrap:wrap;justify-content:flex-start}.service-row{grid-template-columns:38px 1fr 30px;gap:16px;padding:28px 0}.service-row p{grid-column:2/-1}}@media(max-width:430px){.hero-actions{align-items:flex-start;flex-direction:column}}
</style>