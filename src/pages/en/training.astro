---
import SiteLayout from '../../layouts/SiteLayout.astro';
const catalogue=['Cloud Native Application Development','DevOps Methods and Fundamentals','Docker and Container Technologies','Introduction to Kubernetes','AWS Cloud Infrastructure','Microsoft Azure Infrastructure','Infrastructure as Code with Terraform','Git, GitHub and GitHub Actions','Cloud Native Hackathon'];
---
<SiteLayout lang="en" title="Enterprise Training | Ayti.Tech" description="Custom, hands-on cloud, DevOps and platform engineering training.">
	<section class="hero"><div class="container"><p class="eyebrow">Training & Enablement</p><h1>Make knowledge<br />part of the team.</h1><p>Programmes designed around your context and reinforced through real practice.</p></div></section>
	<section class="section process"><div class="container grid"><div><p class="eyebrow">Programme design</p><h2 class="section-heading">From learning goals to working practice.</h2></div><ol><li><b>Needs assessment</b><span>Roles, current capability and business goals.</span></li><li><b>Custom curriculum</b><span>The right depth, examples and scenarios.</span></li><li><b>Hands-on learning</b><span>Live labs, workshops, hackathons and office hours.</span></li><li><b>Growth tracking</b><span>Assessment, feedback and next steps.</span></li></ol></div></section>
	<section class="section catalogue"><div class="container"><p class="eyebrow">Training catalogue</p><h2 class="section-heading">From foundations to production practice.</h2><div class="items">{catalogue.map((x,i)=><div><span>{String(i+1).padStart(2,'0')}</span><h3>{x}</h3></div>)}</div></div></section>
</SiteLayout>
<style>
	.hero{padding:100px 0;background:var(--signal)}.hero h1{margin:0;font-size:clamp(4rem,10vw,8rem);line-height:.85;letter-spacing:0}.hero p:last-child{max-width:600px;margin:50px 0 0 auto;font-size:1.3rem;line-height:1.6}.process{background:var(--paper-strong)}.grid{display:grid;grid-template-columns:1.1fr .9fr;gap:90px}ol{margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}li{display:grid;gap:8px;padding:22px 0;border-bottom:1px solid var(--line)}li span{color:var(--muted)}.catalogue{background:var(--ink);color:white}.items{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #46504c;border-left:1px solid #46504c}.items div{min-height:190px;padding:24px;border-right:1px solid #46504c;border-bottom:1px solid #46504c}.items span{color:var(--signal);font-size:.75rem;font-weight:850}.items h3{margin:38px 0 0;font-size:1.25rem}@media(max-width:760px){.hero{padding:70px 0}.grid{grid-template-columns:1fr;gap:40px}.items{grid-template-columns:1fr}.items div{min-height:140px}}
</style>