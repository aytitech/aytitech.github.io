---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: 'tr' | 'en';
}

const { title, description, lang = 'en' } = Astro.props;
const isEnglish = lang === 'en';
const prefix = isEnglish ? '' : '/tr';
const normalizedPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const alternatePath = isEnglish
	? `/tr${normalizedPath === '/' ? '/' : normalizedPath}`
	: Astro.url.pathname.replace(/^\/tr(?=\/|$)/, '') || '/';
const englishPath = isEnglish ? normalizedPath : alternatePath;
const turkishPath = isEnglish ? alternatePath : Astro.url.pathname;
const canonicalPath = isEnglish ? englishPath : turkishPath;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const englishUrl = new URL(englishPath, Astro.site ?? Astro.url.origin);
const turkishUrl = new URL(turkishPath, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={englishUrl} />
		<link rel="alternate" hreflang="tr" href={turkishUrl} />
		<link rel="alternate" hreflang="x-default" href={englishUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href={`${prefix}/`} aria-label={isEnglish ? 'Ayti.Tech home' : 'Ayti.Tech ana sayfa'}>
					<img src="/brand/aytitech.svg" alt="Ayti.Tech" width="157" height="48" />
				</a>
				<nav aria-label={isEnglish ? 'Primary navigation' : 'Ana menü'}>
					<a href={`${prefix}/services`}>{isEnglish ? 'Services' : 'Hizmetler'}</a>
					<a href={`${prefix}/training`}>{isEnglish ? 'Training' : 'Eğitim'}</a>
					<a href={`${prefix}/insights`}>{isEnglish ? 'Insights' : 'İçgörüler'}</a>
					<a href={`${prefix}/media`}>{isEnglish ? 'Media' : 'Medya'}</a>
					<a href={`${prefix}/about`}>{isEnglish ? 'About' : 'Hakkımızda'}</a>
				</nav>
				<div class="header-actions">
					<a class="language" href={alternatePath}>{isEnglish ? 'TR' : 'EN'}</a>
					<a class="contact-link" href="#contact">{isEnglish ? 'Talk to us' : 'Görüşelim'} <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</header>
		<main><slot /></main>
		<footer id="contact" class="site-footer">
			<div class="container footer-grid">
				<div>
					<p class="eyebrow">{isEnglish ? 'Start a conversation' : 'Bir görüşme başlatın'}</p>
					<h2>{isEnglish ? 'Let’s make the complex workable.' : 'Karmaşık olanı çalışır hale getirelim.'}</h2>
				</div>
				<div class="contact-actions">
					<a class="button" href="https://bookings.cloud.microsoft/book/AytiTech1@ottoo.com/">{isEnglish ? 'Book a meeting' : 'Görüşme planla'} <span aria-hidden="true">↗</span></a>
					<a href="https://wa.me/905423870968">WhatsApp</a>
					<a href="mailto:iletisim@ayti.tech">iletisim@ayti.tech</a>
				</div>
			</div>
			<div class="container footer-bottom">
				<span class="ottoo"><img src="/brand/ottoo.svg" alt="Ottoo" /> © {new Date().getFullYear()} Ottoo Yazılım A.Ş.</span>
				<span>{isEnglish ? 'Istanbul, Türkiye' : 'İstanbul, Türkiye'}</span>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid rgba(16,22,20,.12); background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(14px); }
	.header-inner { display: flex; min-height: 72px; align-items: center; gap: 42px; }
	.brand { display: inline-flex; align-items: center; text-decoration: none; }
	.brand img { width: 132px; height: auto; }
	nav { display: flex; gap: 28px; margin-right: auto; }
	nav a, .language { color: #3e4844; font-size: .88rem; font-weight: 700; text-decoration: none; }
	nav a:hover { color: var(--ink); }
	.header-actions { display: flex; align-items: center; gap: 20px; }
	.contact-link { font-size: .88rem; font-weight: 800; text-decoration: none; }
	.site-footer { padding: 84px 0 26px; background: var(--signal); }
	.footer-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 80px; align-items: end; }
	.footer-grid h2 { max-width: 760px; margin: 0; font-size: clamp(2.4rem, 6vw, 5.4rem); line-height: .98; letter-spacing: 0; }
	.contact-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; font-weight: 750; }
	.footer-bottom { display: flex; justify-content: space-between; gap: 20px; margin-top: 86px; padding-top: 22px; border-top: 1px solid rgba(16,22,20,.35); font-size: .78rem; font-weight: 650; }
	.ottoo { display: inline-flex; align-items: center; gap: 14px; }
	.ottoo img { width: 76px; max-height: 24px; object-fit: contain; }
	@media (max-width: 860px) { nav { display: none; } .header-inner { gap: 20px; } .header-actions { margin-left: auto; } .footer-grid { grid-template-columns: 1fr; gap: 42px; } }
	@media (max-width: 480px) { .contact-link { display: none; } .site-header { position: static; } .footer-bottom { flex-direction: column; margin-top: 56px; } }
</style>