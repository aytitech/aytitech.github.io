---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: 'tr' | 'en';
	type?: 'website' | 'article';
	schema?: Record<string, unknown>;
}

const { title, description, lang = 'en', type = 'website', schema } = Astro.props;
const isEnglish = lang === 'en';
const isLegacyEnglishPath = Astro.url.pathname === '/en/' || Astro.url.pathname.startsWith('/en/');
const prefix = isEnglish ? '' : '/tr';
const normalizedPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const alternatePath = isEnglish
	? `/tr${normalizedPath === '/' ? '/' : normalizedPath}`
	: Astro.url.pathname.replace(/^\/tr(?=\/|$)/, '') || '/';
const englishPath = isEnglish ? normalizedPath : alternatePath;
const turkishPath = isEnglish ? alternatePath : Astro.url.pathname;
const canonicalPath = isEnglish ? englishPath : turkishPath;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const englishUrl = new URL(englishPath, Astro.site ?? Astro.url.origin);
const turkishUrl = new URL(turkishPath, Astro.site ?? Astro.url.origin);
const socialImageUrl = new URL('/og-image.png', Astro.site ?? Astro.url.origin);
const organizationId = new URL('/#organization', Astro.site ?? Astro.url.origin).href;
const websiteId = new URL('/#website', Astro.site ?? Astro.url.origin).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': organizationId,
			name: 'Ayti.Tech',
			legalName: 'Ottoo Yazılım A.Ş.',
			url: new URL('/', Astro.site ?? Astro.url.origin).href,
			logo: new URL('/brand/aytitech.svg', Astro.site ?? Astro.url.origin).href,
			email: 'iletisim@ayti.tech',
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Maslak Mh. Maslak Meydan Sk. Kapı No:1/55',
				addressLocality: 'Sarıyer',
				addressRegion: 'İstanbul',
				addressCountry: 'TR',
			},
			areaServed: ['Türkiye', 'European Union'],
			sameAs: [
				'https://www.linkedin.com/company/aytitech',
				'https://github.com/aytitech',
				'https://www.youtube.com/aytitech',
				'https://www.udemy.com/user/zgrztrk3/',
			],
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			url: new URL('/', Astro.site ?? Astro.url.origin).href,
			name: 'Ayti.Tech',
			publisher: { '@id': organizationId },
			inLanguage: ['en', 'tr'],
		},
		...(schema ? [{ ...schema, '@id': `${canonicalUrl.href}#primary`, url: canonicalUrl.href }] : []),
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="robots" content={isLegacyEnglishPath ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
		<meta name="google-site-verification" content="91bjbLNM08iLTyfQqG-91xSCeC74vP3s0Q6UN_Qpy4Q" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#070f17" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={englishUrl} />
		<link rel="alternate" hreflang="tr" href={turkishUrl} />
		<link rel="alternate" hreflang="x-default" href={englishUrl} />
		<link rel="icon" type="image/svg+xml" href="/brand/aytitech.svg" />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Ayti.Tech" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={isEnglish ? 'Ayti.Tech — Cloud Native under your control' : 'Ayti.Tech — Cloud Native, kontrol sizde'} />
		<meta property="og:locale" content={isEnglish ? 'en_US' : 'tr_TR'} />
		<meta property="og:locale:alternate" content={isEnglish ? 'tr_TR' : 'en_US'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a class="brand" href={`${prefix}/`} aria-label={isEnglish ? 'Ayti.Tech home' : 'Ayti.Tech ana sayfa'}>
					<img src="/brand/aytitech.svg" alt="Ayti.Tech" width="157" height="48" />
				</a>
				<nav class="desktop-nav" aria-label={isEnglish ? 'Primary navigation' : 'Ana menü'}>
					<a href={`${prefix}/services`}>{isEnglish ? 'Services' : 'Hizmetler'}</a>
					<a href={`${prefix}/training`}>{isEnglish ? 'Training' : 'Eğitim'}</a>
					<a href={`${prefix}/insights`}>{isEnglish ? 'Insights' : 'İçgörüler'}</a>
					<a href={`${prefix}/media`}>{isEnglish ? 'Media' : 'Medya'}</a>
					<a href={`${prefix}/about`}>{isEnglish ? 'About' : 'Hakkımızda'}</a>
				</nav>
				<div class="header-actions">
					<a class="language" href={alternatePath}>{isEnglish ? 'TR' : 'EN'}</a>
					<a class="contact-link" href="#contact">{isEnglish ? 'Talk to us' : 'Görüşelim'} <span aria-hidden="true">↗</span></a>
				</div>
				<details class="mobile-nav">
					<summary>
						<span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
						<span>{isEnglish ? 'Menu' : 'Menü'}</span>
					</summary>
					<nav aria-label={isEnglish ? 'Mobile navigation' : 'Mobil menü'}>
						<a href={`${prefix}/services`}>{isEnglish ? 'Services' : 'Hizmetler'} <span aria-hidden="true">↗</span></a>
						<a href={`${prefix}/training`}>{isEnglish ? 'Training' : 'Eğitim'} <span aria-hidden="true">↗</span></a>
						<a href={`${prefix}/insights`}>{isEnglish ? 'Insights' : 'İçgörüler'} <span aria-hidden="true">↗</span></a>
						<a href={`${prefix}/media`}>{isEnglish ? 'Media' : 'Medya'} <span aria-hidden="true">↗</span></a>
						<a href={`${prefix}/about`}>{isEnglish ? 'About' : 'Hakkımızda'} <span aria-hidden="true">↗</span></a>
						<a href={`${prefix}/#contact`}>{isEnglish ? 'Talk to us' : 'Görüşelim'} <span aria-hidden="true">↘</span></a>
					</nav>
				</details>
			</div>
		</header>
		<main><slot /></main>
		<footer id="contact" class="site-footer">
			<div class="container footer-grid">
				<div>
					<p class="eyebrow">{isEnglish ? 'Start a conversation' : 'Bir görüşme başlatın'}</p>
					<h2>{isEnglish ? 'Let’s make the complex workable.' : 'Karmaşık olanı çalışır hale getirelim.'}</h2>
				</div>
				<div class="contact-actions">
					<a class="button" href="https://bookings.cloud.microsoft/book/AytiTech1@ottoo.com/">{isEnglish ? 'Book a meeting' : 'Görüşme planla'} <span aria-hidden="true">↗</span></a>
					<a href="https://wa.me/905423870968">WhatsApp</a>
					<a href="mailto:iletisim@ayti.tech">iletisim@ayti.tech</a>
				</div>
			</div>
			<div class="container footer-bottom">
				<span class="ottoo"><img src="/brand/ottoo.svg" alt="Ottoo" /> © {new Date().getFullYear()} Ottoo Yazılım A.Ş.</span>
				<span>{isEnglish ? 'Istanbul · Berlin' : 'İstanbul · Berlin'}</span>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid rgba(16,22,20,.12); background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(14px); }
	.header-inner { display: flex; min-height: 72px; align-items: center; gap: 42px; }
	.brand { display: inline-flex; align-items: center; text-decoration: none; }
	.brand img { width: 132px; height: auto; }
	.desktop-nav { display: flex; gap: 28px; margin-right: auto; }
	.desktop-nav a, .language { color: #3e4844; font-size: .88rem; font-weight: 700; text-decoration: none; }
	.desktop-nav a:hover { color: var(--ink); }
	.header-actions { display: flex; align-items: center; gap: 20px; }
	.contact-link { font-size: .88rem; font-weight: 800; text-decoration: none; }
	.mobile-nav { display: none; }
	.site-footer { padding: 84px 0 26px; background: var(--signal); }
	.footer-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: 80px; align-items: end; }
	.footer-grid h2 { max-width: 760px; margin: 0; font-size: clamp(2.4rem, 6vw, 5.4rem); line-height: .98; letter-spacing: 0; }
	.contact-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; font-weight: 750; }
	.footer-bottom { display: flex; justify-content: space-between; gap: 20px; margin-top: 86px; padding-top: 22px; border-top: 1px solid rgba(16,22,20,.35); font-size: .78rem; font-weight: 650; }
	.ottoo { display: inline-flex; align-items: center; gap: 14px; }
	.ottoo img { width: 76px; max-height: 24px; object-fit: contain; }
	@media (max-width: 860px) {
		.site-header { position: sticky; }
		.header-inner { position: relative; gap: 18px; }
		.desktop-nav, .contact-link { display: none; }
		.header-actions { margin-left: auto; }
		.mobile-nav { display: block; }
		.mobile-nav summary { display: inline-flex; min-height: 42px; align-items: center; gap: 9px; padding: 0 10px; cursor: pointer; font-size: .82rem; font-weight: 800; list-style: none; }
		.mobile-nav summary::-webkit-details-marker { display: none; }
		.menu-icon { display: grid; width: 20px; gap: 4px; }
		.menu-icon i { display: block; height: 2px; background: var(--ink); transition: transform .2s, opacity .2s; }
		.mobile-nav[open] .menu-icon i:first-child { transform: translateY(6px) rotate(45deg); }
		.mobile-nav[open] .menu-icon i:nth-child(2) { opacity: 0; }
		.mobile-nav[open] .menu-icon i:last-child { transform: translateY(-6px) rotate(-45deg); }
		.mobile-nav nav { position: absolute; top: calc(100% + 1px); right: 0; left: 0; display: grid; padding: 12px 20px 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper-strong); box-shadow: 0 18px 35px rgba(7,15,23,.12); }
		.mobile-nav nav a { display: flex; min-height: 52px; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); font-weight: 760; text-decoration: none; }
		.mobile-nav nav a:last-child { border-bottom: 0; color: var(--orange); }
		.footer-grid { grid-template-columns: 1fr; gap: 42px; }
	}
	@media (max-width: 480px) { .brand img { width: 116px; } .footer-bottom { flex-direction: column; margin-top: 56px; } }
</style>
